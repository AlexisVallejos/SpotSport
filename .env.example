# Conexión a Supabase. Copiá este archivo a .env y completá los valores.
# Los dos salen de Supabase → Project Settings → API. La clave "anon/publishable" es pública por diseño:
# los permisos los hacen cumplir las políticas de la base (RLS), no esta clave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Contraseña de la base (Project Settings → Database). Solo para psql / supabase CLI en tu máquina.
# Sin prefijo VITE_ a propósito: nunca debe llegar al navegador ni al código del cliente.
SUPABASE_DB_PASSWORD=

# API de precios (server/main.ts). Opcionales: estos son los valores por defecto.
# Carpeta donde se guardan precios, historial y reseñas (en Docker: /data, montala como volumen).
DATA_DIR=data
# Cada cuántas horas se vuelven a leer Open Sports, Dexter y Trip Store.
PRICE_REFRESH_HOURS=6
# Pausa entre páginas de una misma tienda, para no cargarles el sitio.
PRICE_DELAY_MS=1500

# Compras con SPOT (Mercado Pago Checkout Pro). Sin MP_ACCESS_TOKEN la API queda en modo prueba:
# el pago se aprueba solo y el ticket sale marcado como "PRUEBA".
# El token sale de mercadopago.com.ar/developers → Tus integraciones → Credenciales (de prueba o de producción).
# Es secreto: va sólo en el servidor, nunca con prefijo VITE_.
MP_ACCESS_TOKEN=
# Dirección pública del sitio (https://…). Mercado Pago vuelve ahí y avisa los pagos por webhook;
# también es el link que lleva el QR. Si queda vacía se toma del pedido (sirve en desarrollo).
PUBLIC_URL=
